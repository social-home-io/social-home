{
	"name": "Social Home Dev Container",
	"image": "mcr.microsoft.com/devcontainers/python:3.14",

	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"upgradePackages": true
		},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	// One-time setup after the container is created.
	//
	// We pin uv to the python-feature's interpreter at
	// ``/usr/local/python/current/bin/python``. The base image
	// (``mcr.microsoft.com/devcontainers/python:3.14``) sets up
	// **two** Python installs:
	//   - ``/usr/local/python/3.14.4/...`` — the python-feature
	//     install, owned by ``root:python`` and group-writable
	//     so ``vscode`` can ``pip install`` into it.
	//   - ``/usr/local/lib/python3.14/...`` — Debian's Python,
	//     root-owned and not writable by ``vscode``.
	// Without ``--python``, uv discovers the latter first and
	// fails with ``Permission denied`` halfway through the
	// install.
	//
	// ``UV_PYTHON`` (containerEnv) makes the same pin apply to
	// any ad-hoc ``uv pip install`` calls inside the running
	// container. ``PIP_USER=false`` + ``UV_SYSTEM_PYTHON=1``
	// keep them in system site-packages instead of falling back
	// to ``~/.local`` (which produces partial installs that
	// shadow the real ones — see the original ``aiolibdatachannel``
	// ``_native.so`` bug).
	//
	// 1. Install ``uv`` via its official static-binary installer
	//    (drops the binary into ``~/.local/bin``; no Python
	//    dependency).
	// 2. Install the Python project in editable mode + dev extras
	//    (pytest, mypy, ruff, pre-commit, ...).
	// 3. Wire up the pre-commit hooks so ``git commit`` runs ruff +
	//    mypy + frontend ESLint + tsc on staged files.
	// 4. Install pnpm globally (Node feature ships npm; we use pnpm
	//    for the frontend per ``client/package.json``).
	// 5. Install the frontend deps so ``pnpm run dev`` works on
	//    first launch without manual steps.
	"postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && $HOME/.local/bin/uv pip install --system -e '.[dev]' && pre-commit install && npm install -g pnpm && cd client && pnpm install",
	"containerEnv": {
		"PIP_USER": "false",
		"UV_SYSTEM_PYTHON": "1",
		"UV_PYTHON": "/usr/local/python/current/bin/python"
	},

	// 8099 = aiohttp backend (``python -m socialhome``).
	// 5173 = Vite dev server (``pnpm run dev`` in ``client/``).
	"forwardPorts": [8099, 5173],
	"portsAttributes": {
		"8099": {
			"label": "socialhome backend",
			"onAutoForward": "silent"
		},
		"5173": {
			"label": "vite dev",
			"onAutoForward": "openBrowser"
		}
	},

	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.testing.pytestEnabled": true,
				"python.testing.pytestArgs": ["tests"],
				"editor.formatOnSave": true,
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.codeActionsOnSave": {
						"source.fixAll.ruff": "explicit",
						"source.organizeImports.ruff": "explicit"
					}
				},
				"[typescript]": {
					"editor.defaultFormatter": "dbaeumer.vscode-eslint"
				},
				"[typescriptreact]": {
					"editor.defaultFormatter": "dbaeumer.vscode-eslint"
				},
				"files.exclude": {
					"**/__pycache__": true,
					"**/.pytest_cache": true,
					"**/.ruff_cache": true,
					"**/.mypy_cache": true,
					"**/node_modules": true
				}
			},
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",
				"dbaeumer.vscode-eslint",
				"vitest.explorer",
				"esbenp.prettier-vscode"
			]
		}
	}
}
