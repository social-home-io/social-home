{
	"name": "Social Home Dev Container",
	"image": "mcr.microsoft.com/devcontainers/python:3.14",

	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"upgradePackages": true
		},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		// uv is the Python package manager — an order of magnitude
		// faster than pip with stricter defaults. The feature drops
		// the static binary on PATH at container build time so the
		// postCreate flow below can use ``uv`` directly.
		"ghcr.io/jsburckhardt/devcontainer-features/uv:1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	// One-time setup after the container is created.
	//
	// The base image ships Python at a root-owned site-packages
	// path that the ``vscode`` user can't write to, so we use a
	// project-local virtualenv at ``.venv/``. uv creates the venv
	// from the system Python on PATH and installs the editable
	// project + dev extras into it; VS Code points at
	// ``${workspaceFolder}/.venv/bin/python`` as the default
	// interpreter, and the run/debug tasks invoke that interpreter
	// explicitly.
	//
	// ``--clear`` recreates the venv from scratch on every rebuild
	// so a stale dev container can never linger with a half-broken
	// interpreter. ``--refresh`` on ``uv pip install`` re-checks
	// PyPI for the latest matching version (defeats uv's package
	// metadata cache, which can hold a stale view of versions
	// across container rebuilds).
	//
	// 1. Create / recreate the project venv at ``.venv/`` from the
	//    system Python on PATH (whichever 3.14 the image ships).
	// 2. Install the Python project in editable mode + dev extras.
	//    uv auto-detects the in-tree venv and installs there.
	// 3. Wire up the pre-commit hooks so ``git commit`` runs ruff +
	//    mypy + frontend ESLint + tsc on staged files.
	// 4. Install pnpm globally (Node feature ships npm; we use pnpm
	//    for the frontend per ``client/package.json``).
	// 5. Install the frontend deps so ``pnpm run dev`` works on
	//    first launch without manual steps.
	"postCreateCommand": "uv venv .venv --seed --clear && uv pip install --refresh -e '.[dev]' && .venv/bin/pre-commit install && npm install -g pnpm && cd client && pnpm install",
	"containerEnv": {
		// Hardlink mode for ``uv pip install`` is ~2-3× faster than
		// copy mode but only works when the cache and the target
		// venv live on the **same filesystem**. The default cache
		// at ``~/.cache/uv`` sits on the container's overlay FS,
		// while ``.venv/`` lives on the bind-mounted workspace
		// volume → hardlinks fail and uv warns. Pinning the cache
		// inside the workspace puts both on the same FS, so
		// hardlinks work and the warning goes away.
		"UV_LINK_MODE": "hardlink",
		"UV_CACHE_DIR": "${containerWorkspaceFolder}/.uv-cache"
	},

	// 8099 = aiohttp backend (``python -m socialhome``).
	// 5173 = Vite dev server (``pnpm run dev`` in ``client/``).
	"forwardPorts": [8099, 5173],
	"portsAttributes": {
		"8099": {
			"label": "socialhome backend",
			"onAutoForward": "silent"
		},
		"5173": {
			"label": "vite dev",
			"onAutoForward": "openBrowser"
		}
	},

	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
				"python.testing.pytestEnabled": true,
				"python.testing.pytestArgs": ["tests"],
				"python.terminal.activateEnvironment": true,
				"editor.formatOnSave": true,
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.codeActionsOnSave": {
						"source.fixAll.ruff": "explicit",
						"source.organizeImports.ruff": "explicit"
					}
				},
				"[typescript]": {
					"editor.defaultFormatter": "dbaeumer.vscode-eslint"
				},
				"[typescriptreact]": {
					"editor.defaultFormatter": "dbaeumer.vscode-eslint"
				},
				"files.exclude": {
					"**/__pycache__": true,
					"**/.pytest_cache": true,
					"**/.ruff_cache": true,
					"**/.mypy_cache": true,
					"**/node_modules": true
				}
			},
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",
				"dbaeumer.vscode-eslint",
				"vitest.explorer",
				"esbenp.prettier-vscode"
			]
		}
	}
}
